mode systems

# The four commands: add, install, list, remove.

import "strutil.tw" as s
import "semver.tw" as semver
import "manifest.tw" as manifest
import "lockfile.tw" as lockfile
import "pkghash.tw" as pkghash
import "resolve.tw" as resolve
import "vendor.tw" as vendor
import "ui.tw" as ui

struct Project {
  root: Str,
  manifest: manifest.Manifest,
}

# `read_file` returns a `Res[Str, Str]`. Every call in this file used to pass it
# straight into a parser, which then took the length of a `Res` -- so `spool
# list` and every other command that opens a project died with "len expects a
# tensor, list, string, dict or bytes" before reaching any of its own logic.
# Nothing caught it: the tests call the command functions with fixture text and
# never read a file.
fn read_text(path: Str) -> Res[Str, Str] = read_file(path)

# open walks up from dir looking for a spool.toml, so spool can be run from a
# subdirectory of a project the way git can.
fn open(dir: Str) -> Res[Project, Str] {
  let at = dir
  while true {
    let path = path_join(at, manifest.MANIFEST_NAME)
    if path_exists(path) {
      let text: Str = read_text(path)?
      let m: manifest.Manifest = match manifest.parse(text) {
        Ok(parsed) => parsed,
        Err(msg) => return Err(manifest.MANIFEST_NAME + ": " + msg),
      }
      return Ok(Project { root: at, manifest: m })
    }
    let cut = s.last_index_of_byte(at, s.B_SLASH)
    if cut <= 0 {
      return Err("no " + manifest.MANIFEST_NAME
        + " here or in any parent directory; run `spool init` first")
    }
    at = at[0:cut]
  }
  Err("unreachable")
}

# An absent lockfile is an empty one and not a failure: a project nobody has
# installed yet is the ordinary first-run state.
fn load_lock(root: Str) -> Res[lockfile.Lock, Str] {
  let path = path_join(root, lockfile.LOCK_NAME)
  if not path_exists(path) {
    return Ok(lockfile.empty_lock())
  }
  lockfile.parse(read_text(path)?)
}

# lock_satisfies reports whether every declared dependency has a lock entry
# whose version and git source still match the manifest.
#
# This is what lets `spool install` be offline and reproducible in the common
# case: if the lockfile already answers the question the manifest asks, there is
# no reason to talk to a network. It deliberately does not check transitive
# dependencies, because the lockfile does not record which package required
# what; a changed transitive constraint is caught the next time the tree is
# resolved, and `spool install --update` forces that.
fn lock_satisfies(m: manifest.Manifest, l: lockfile.Lock) -> Res[Unit, Str] {
  let i = 0
  while i < len(m.deps) {
    let d = m.deps[i]
    i = i + 1
    let e = match lockfile.find(l, d.name) {
      Some(at) => l.packages[at],
      None => return Err(d.name + " is declared but not locked"),
    }
    if e.git != d.git {
      return Err(d.name + " is locked from " + e.git + " but declared from " + d.git)
    }
    let c = semver.parse_constraint(d.version)
    let v = semver.parse(e.version)
    if not v.ok {
      return Err(d.name + " has an unreadable locked version " + e.version)
    }
    if not semver.matches(c, v) {
      return Err(d.name + " is locked at " + e.version + ", which no longer satisfies " + c.text)
    }
  }
  # A locked package the manifest does not name is assumed to be transitive.
  # The lockfile does not record dependency edges, so there is no way to tell a
  # genuine orphan from a package that some dependency pulled in. The
  # consequence is that dropping a dependency does not by itself make the lock
  # unsatisfying, which is why `remove` re-resolves rather than relying on this.
  Ok(unit)
}

fn cmd_install(dir: Str, update: Bool) -> Res[Unit, Str] {
  let p: Project = open(dir)?
  let l: lockfile.Lock = load_lock(p.root)?

  let reuse = false
  if len(l.packages) > 0 and not update {
    match lock_satisfies(p.manifest, l) {
      Ok(_) => reuse = true,
      # Not a failure: the lock no longer matches the manifest, which is the
      # ordinary reason to resolve again, and the message says which dependency.
      Err(why) => print(ui.reresolving(why)),
    }
  }

  if not reuse {
    let cat = resolve.Catalog { versions: {}, deps: {} }
    vendor.build_catalog(p.root, p.manifest, cat)?
    let r: resolve.Resolution = resolve.resolve(p.manifest, cat)?
    let next = lockfile.empty_lock()
    let i = 0
    while i < len(r.packages) {
      let pkg = r.packages[i]
      i = i + 1
      let c = vendor.commit_for(p.root, pkg.git, pkg.version)
      if not vendor.git_ok(c) {
        return Err(pkg.name + " " + pkg.version + ": " + vendor.git_out(c))
      }
      let commit = vendor.git_out(c)
      let hash = ""
      # Carry a previously recorded hash forward when the commit has not moved.
      # Recomputing it would give the same answer, but reusing it means that a
      # changed hash in the diff always signals that the contents under a pinned
      # commit changed, which is exactly the alarm worth raising.
      match lockfile.find(l, pkg.name) {
        Some(prev) => if l.packages[prev].commit == commit {
          hash = l.packages[prev].hash
        },
        None => unit,
      }
      push(next.packages, lockfile.Entry {
        name: pkg.name, version: pkg.version, git: pkg.git, commit: commit, hash: hash,
      })
    }
    l = next
  }

  materialise(p.root, l)?
  write_file(path_join(p.root, lockfile.LOCK_NAME), lockfile.render(l))
  print(ui.vendored(vendor.VENDOR_DIR))
  Ok(unit)
}

# materialise writes every locked package into the vendor directory and
# verifies its contents against the lockfile.
fn materialise(root: Str, l: lockfile.Lock) -> Res[Unit, Str] {
  let vendor_root = path_join(root, vendor.VENDOR_DIR)
  let i = 0
  while i < len(l.packages) {
    let e = l.packages[i]
    i = i + 1
    let dst = path_join(vendor_root, e.name)

    if pkghash.is_hash(e.hash) and path_exists(dst) {
      let on_disk = vendor.read_tree(dst)
      if on_disk.hash == e.hash {
        print(ui.up_to_date(e.name, e.version))
        continue
      }
    }

    print(ui.fetching(e.name, e.version, short_commit(e.commit)))
    let export_err = vendor.export(root, e.git, e.commit, dst)
    if len(export_err) > 0 {
      return Err(export_err)
    }
    let got = vendor.read_tree(dst)
    if not pkghash.is_hash(e.hash) {
      # First install of this commit: record what arrived. There is nothing to
      # compare against yet, and pretending otherwise would be theatre.
      l.packages[i - 1].hash = got.hash
      continue
    }
    let bad = pkghash.verify(e.name, got.hash, e.hash)
    if len(bad) > 0 {
      # The bad tree is left in place. Deleting the evidence of a mismatch makes
      # it impossible to find out what actually arrived.
      return Err(bad + "\nthe fetched tree was left in " + dst + " for inspection")
    }
  }
  prune(vendor_root, l)
  write_file(path_join(vendor_root, "README"), vendor_readme())
  Ok(unit)
}

# prune removes vendored directories nothing locks, so the vendor directory
# never accumulates a package the project stopped using.
fn prune(vendor_root: Str, l: lockfile.Lock) {
  if not path_exists(vendor_root) {
    return
  }
  let entries = list_dir(vendor_root)
  let i = 0
  while i < len(entries) {
    let name = entries[i]
    i = i + 1
    if name == "README" {
      continue
    }
    if lockfile.has(l, name) {
      continue
    }
    print(ui.removing(name))
    remove_all(path_join(vendor_root, name))
  }
}

# vendor_readme leaves a note in the vendor directory, because the first thing
# anyone does on finding an unexplained directory of someone else's code in
# their repository is wonder whether to commit it.
fn vendor_readme() -> Str {
  "This directory is written by spool. Do not edit it and do not commit it.\n"
    + "Add `" + vendor.VENDOR_DIR + "/` to .gitignore and commit spool.toml and\n"
    + "spool.lock instead; `spool install` reproduces this directory from those two.\n"
}

fn short_commit(commit: Str) -> Str {
  if len(commit) > 12 {
    return commit[0:12]
  }
  commit
}

fn cmd_add(dir: Str, name: Str, url: Str, requested: Str) -> Res[Unit, Str] {
  let name_err = manifest.validate_name(name)
  if len(name_err) > 0 {
    return Err(name_err)
  }
  let p: Project = open(dir)?

  let constraint = requested
  if len(constraint) == 0 {
    # With no version given, pin to the highest published version with a caret.
    # Defaulting to "*" would be less code and would silently opt the project
    # into the next major release of a dependency.
    let versions = vendor.published_versions(p.root, url)
    if len(versions) == 0 {
      return Err(url + " publishes no version tags that spool can read; pass a version explicitly")
    }
    let sorted = s.sort_strs(versions)
    let best = semver.parse(sorted[0])
    let i = 1
    while i < len(sorted) {
      let v = semver.parse(sorted[i])
      if v.ok and semver.compare(v, best) > 0 {
        best = v
      }
      i = i + 1
    }
    constraint = "^" + semver.to_str(best)
  }
  if not semver.parse_constraint(constraint).ok {
    return Err(constraint + " is not a version or a `^` range")
  }

  let path = path_join(p.root, manifest.MANIFEST_NAME)
  let d = manifest.Dep { name: name, version: constraint, git: url }
  write_file(path, manifest.add_dep(read_text(path)?, d))
  print(ui.added(name, constraint))
  cmd_install(dir, false)
}

fn cmd_remove(dir: Str, name: Str) -> Res[Unit, Str] {
  let p: Project = open(dir)?
  let path = path_join(p.root, manifest.MANIFEST_NAME)
  let out = manifest.remove_dep(read_text(path)?, name)
  if out[0] != s.B_SPACE {
    return Err(name + " is not a declared dependency")
  }
  write_file(path, out[1:len(out)])
  print(ui.removed(name))
  # A full re-resolve, not a reinstall. The lockfile does not record which
  # dependency required what, so re-resolving is the only way to learn which
  # transitive packages went away with this one.
  cmd_install(dir, true)
}

fn cmd_list(dir: Str) -> Res[Unit, Str] {
  let p: Project = open(dir)?
  let l: lockfile.Lock = load_lock(p.root)?

  print(p.manifest.name + " " + p.manifest.version)
  if len(p.manifest.deps) == 0 {
    print("  no dependencies declared")
    # An early SUCCESS: there is nothing more to list. Under the old convention
    # this was `return ""`, the same two bytes as the success at the bottom of
    # the function, so nothing said which it was.
    return Ok(unit)
  }

  let direct: Dict[Str, Str] = {}
  let i = 0
  while i < len(p.manifest.deps) {
    let d = p.manifest.deps[i]
    i = i + 1
    direct[d.name] = d.version
    match lockfile.find(l, d.name) {
      Some(at) => print("  " + s.pad_right(l.packages[at].name, 20)
        + s.pad_right(l.packages[at].version, 10) + s.pad_right(d.version, 10)
        + ui.state(install_state(p.root, l.packages[at]))),
      None => print("  " + s.pad_right(d.name, 20) + s.pad_right("-", 10)
        + s.pad_right(d.version, 10) + "not installed"),
    }
  }

  let shown_header = false
  let j = 0
  while j < len(l.packages) {
    let e = l.packages[j]
    j = j + 1
    if dict_has(direct, e.name) {
      continue
    }
    if not shown_header {
      print("  (pulled in by the above)")
      shown_header = true
    }
    print("  " + s.pad_right(e.name, 20) + s.pad_right(e.version, 10) + s.pad_right("", 10)
      + ui.state(install_state(p.root, e)))
  }

  if len(l.packages) == 0 {
    print("")
    print("no " + lockfile.LOCK_NAME + " yet; run `spool install`")
  }
  Ok(unit)
}

# install_state reports whether what is on disk matches what the lockfile
# recorded. `spool list` is where a user finds out that a vendored package was
# edited or went missing, so it re-hashes rather than trusting that the
# directory exists.
fn install_state(root: Str, e: lockfile.Entry) -> Str {
  let dst = path_join(path_join(root, vendor.VENDOR_DIR), e.name)
  if not path_exists(dst) {
    return "not installed"
  }
  if vendor.read_tree(dst).hash != e.hash {
    return "modified (run `spool install`)"
  }
  "ok"
}

fn cmd_init(dir: Str, name: Str) -> Res[Unit, Str] {
  let path = path_join(dir, manifest.MANIFEST_NAME)
  if path_exists(path) {
    return Err(manifest.MANIFEST_NAME + " already exists")
  }
  match manifest.validate_name(name) {
    Ok(_) => unit,
    Err(msg) => return Err(msg + "; pass one: spool init <name>"),
  }
  let m = manifest.Manifest {
    name: name, version: "0.1.0", entry: name + ".tw", deps: [],
  }
  write_file(path, manifest.render(m))
  print("wrote " + manifest.MANIFEST_NAME)
  Ok(unit)
}
