mode systems

# spool.lock: the record of exactly what was installed.
#
# Everything here is built around one property: the same resolution renders the
# same bytes, always. Entries are sorted by name, fields come out in a fixed
# order, and nothing about the machine that produced the file (paths, times,
# dictionary order) reaches the output. A lockfile that churns is a lockfile
# people stop reading in review, and an unread lockfile defeats the point of
# having one.

import "strutil.tw" as s
import "toml.tw" as toml
import "pkghash.tw" as pkghash
import "std/text" as text

let LOCK_NAME = "spool.lock"

# LOCK_VERSION is the file format version. A file written by a newer spool is
# refused rather than misread.
let LOCK_VERSION = 1

let LOCK_HEADER = "# spool.lock -- generated by spool. Commit this file.\n"
  + "# It records the exact commit and content hash of every dependency, so\n"
  + "# `spool install` reproduces the same tree on any machine.\n"

struct Entry {
  name: Str,
  version: Str,
  git: Str,
  commit: Str,
  hash: Str,
}

struct Lock {
  packages: Arr[Entry],
  err: Str,
}

fn empty_lock() -> Lock {
  Lock { packages: [], err: "" }
}

fn error_lock(msg: Str) -> Lock {
  Lock { packages: [], err: LOCK_NAME + ": " + msg }
}

fn find(l: Lock, name: Str) -> Opt[I64] {
  let i = 0
  while i < len(l.packages) {
    if l.packages[i].name == name {
      return Some(i)
    }
    i = i + 1
  }
  None
}

fn has(l: Lock, name: Str) -> Bool {
  match find(l, name) {
    Some(_) => true,
    None => false,
  }
}

fn sort_entries(entries: Arr[Entry]) -> Arr[Entry] {
  let out: Arr[Entry] = []
  let i = 0
  while i < len(entries) {
    push(out, entries[i])
    i = i + 1
  }
  let j = 1
  while j < len(out) {
    let cur = out[j]
    let k = j - 1
    while k >= 0 and s.compare_str(out[k].name, cur.name) > 0 {
      out[k + 1] = out[k]
      k = k - 1
    }
    out[k + 1] = cur
    j = j + 1
  }
  out
}

# render builds into a Bytes. Six concatenations per package against a string
# that already holds every package before it is quadratic in the size of the
# lockfile, and the lockfile grows with the transitive dependency tree rather
# than with anything the author wrote. The bytes produced are exactly what the
# `+` version produced, field for field and newline for newline; this file's
# whole point is that the same resolution renders the same bytes.
fn render(l: Lock) -> Str {
  let out: Bytes = bytes_new()
  text.push_str(out, LOCK_HEADER + "\nversion = " + s.i64_to_str(LOCK_VERSION) + "\n")
  let pkgs = sort_entries(l.packages)
  let i = 0
  while i < len(pkgs) {
    let p = pkgs[i]
    text.push_str(out, "\n[[package]]\n")
    text.push_str(out, "name = " + toml.quote(p.name) + "\n")
    text.push_str(out, "version = " + toml.quote(p.version) + "\n")
    text.push_str(out, "git = " + toml.quote(p.git) + "\n")
    text.push_str(out, "commit = " + toml.quote(p.commit) + "\n")
    text.push_str(out, "hash = " + toml.quote(p.hash) + "\n")
    i = i + 1
  }
  bytes_to_str(out)
}

# parse reads a lockfile. This is a separate reader from the manifest's because
# the lockfile is a machine-written array of tables and the manifest is a
# hand-written file with inline tables. Sharing one reader would mean each
# accepting syntax the other should reject, which is how a hand-edited lockfile
# ends up parsing.
fn parse(src: Str) -> Lock {
  let l = empty_lock()
  let seen_version = false
  let in_package = false
  let lines = s.split_lines(src)
  let n = 0
  while n < len(lines) {
    let line_no = n + 1
    let line = s.trim(toml.strip_comment(lines[n]))
    n = n + 1
    if len(line) == 0 {
      continue
    }
    let where = "line " + s.i64_to_str(line_no) + ": "

    if line == "[[package]]" {
      push(l.packages, Entry { name: "", version: "", git: "", commit: "", hash: "" })
      in_package = true
      continue
    }
    if line[0] == s.B_LBRACKET {
      return error_lock(where + "unexpected table header " + line)
    }

    let eq = match s.index_of_byte(line, s.B_EQ) {
      Some(at) => at,
      None => return error_lock(where + "expected `key = value`, got " + line),
    }
    let key = s.trim(line[0:eq])
    let raw = s.trim(line[eq + 1:len(line)])

    if not in_package {
      if key != "version" {
        return error_lock(where + "unknown top-level key " + key)
      }
      if seen_version {
        return error_lock(where + "duplicate `version`")
      }
      seen_version = true
      if raw != s.i64_to_str(LOCK_VERSION) {
        return error_lock(where + "lockfile format version " + raw + "; this spool writes version "
          + s.i64_to_str(LOCK_VERSION) + ", so upgrade spool or delete the lockfile and reinstall")
      }
      continue
    }

    let val = toml.unquote(raw)
    if not toml.unquote_ok(val) {
      return error_lock(where + "expected a quoted string for " + key)
    }
    let v = toml.unquote_value(val)
    let last = len(l.packages) - 1
    if key == "name" {
      l.packages[last].name = v
      continue
    }
    if key == "version" {
      l.packages[last].version = v
      continue
    }
    if key == "git" {
      l.packages[last].git = v
      continue
    }
    if key == "commit" {
      l.packages[last].commit = v
      continue
    }
    if key == "hash" {
      l.packages[last].hash = v
      continue
    }
    return error_lock(where + "unknown package key " + key)
  }

  if not seen_version {
    return error_lock("missing `version`; this does not look like a spool lockfile")
  }
  let i = 0
  while i < len(l.packages) {
    let p = l.packages[i]
    if len(p.name) == 0 {
      return error_lock("a [[package]] entry has no `name`")
    }
    if len(p.version) == 0 or len(p.git) == 0 or len(p.commit) == 0 or len(p.hash) == 0 {
      return error_lock("package " + p.name + " is missing a required field")
    }
    if not pkghash.is_hash(p.hash) {
      return error_lock("package " + p.name + " has a hash spool cannot verify: " + p.hash)
    }
    let j = 0
    while j < i {
      if l.packages[j].name == p.name {
        return error_lock("package " + p.name + " is locked twice")
      }
      j = j + 1
    }
    i = i + 1
  }
  l.packages = sort_entries(l.packages)
  l
}
