mode systems

# Semantic versions and the two constraint forms spool understands.
#
# Pre-release and build metadata are deliberately absent. Pre-release ordering
# is where most semver implementations grow their bugs, and a package manager
# for a language with a handful of packages does not earn that complexity. The
# cost is real: a package cannot publish "1.0.0-rc1" and have spool sort it
# before "1.0.0". Such a tag is rejected rather than silently mis-ordered.

import "strutil.tw" as s

struct Version {
  major: I64,
  minor: I64,
  patch: I64,
  # ok is false when parsing failed. The subset has no Opt or Res, so a
  # sentinel field is the only way to report failure without aborting; see
  # docs/needs.md.
  ok: Bool,
}

# A constraint is one of three shapes, and two of them are measured against a
# version while the third is not. As an I64 tag beside a `base: Version` field
# that had to be filled in with a meaningless value for `*`, nothing stopped a
# reader of `base` from trusting it in the one case where it means nothing. The
# payload puts the version where it applies and nowhere else, and it makes the
# dispatch in `matches` exhaustive: a fourth constraint form is a check error
# here rather than a silent fall-through into the caret arm.
enum ConstraintKind { Exact(Version), Caret(Version), Any }

struct Constraint {
  kind: ConstraintKind,
  text: Str,
  ok: Bool,
}

fn bad_version() -> Version {
  Version { major: 0, minor: 0, patch: 0, ok: false }
}

# parse reads "1.2.3", tolerating a leading "v" so a git tag can be handed in
# unchanged. Leading zeroes are accepted and normalised away, which means
# "1.02.0" and "1.2.0" are the same version; refusing them would be defensible
# but would reject tags that already exist in the wild.
fn parse(raw: Str) -> Version {
  let text = s.trim_prefix(s.trim(raw), "v")
  let parts = s.split_byte(text, s.B_DOT)
  if len(parts) != 3 {
    return bad_version()
  }
  match parse_triple(parts) {
    Some(v) => v,
    None => bad_version(),
  }
}

# parse_triple is where the three components are read. `?` needs an enclosing
# function returning an Opt and `parse` returns a Version carrying its own `ok`
# field, so the three fallible reads live here and `parse` turns the one failure
# into a bad_version. Written inline that is three nested matches around one
# struct literal.
fn parse_triple(parts: Arr[Str]) -> Opt[Version] {
  let major = s.parse_i64(parts[0])?
  let minor = s.parse_i64(parts[1])?
  let patch = s.parse_i64(parts[2])?
  Some(Version { major: major, minor: minor, patch: patch, ok: true })
}

fn to_str(v: Version) -> Str {
  s.i64_to_str(v.major) + "." + s.i64_to_str(v.minor) + "." + s.i64_to_str(v.patch)
}

fn compare(a: Version, b: Version) -> I64 {
  if a.major != b.major {
    if a.major < b.major {
      return -1
    }
    return 1
  }
  if a.minor != b.minor {
    if a.minor < b.minor {
      return -1
    }
    return 1
  }
  if a.patch != b.patch {
    if a.patch < b.patch {
      return -1
    }
    return 1
  }
  0
}

fn bad_constraint(text: Str) -> Constraint {
  Constraint { kind: Exact(bad_version()), text: text, ok: false }
}

# parse_constraint reads "1.2.3" (exact), "^1.2.3" (compatible) or "*" (any).
# Ranges, "~" and comparison operators are not supported. An unrecognised
# spelling is an error rather than a silent "any": quietly widening a constraint
# the author wrote narrowly is the worse failure, because it shows up as a
# surprise upgrade rather than as a message.
fn parse_constraint(raw: Str) -> Constraint {
  let text = s.trim(raw)
  if text == "*" {
    return Constraint { kind: Any, text: "*", ok: true }
  }
  if s.starts_with(text, "^") {
    let base = parse(s.trim_prefix(text, "^"))
    if not base.ok {
      return bad_constraint(text)
    }
    return Constraint { kind: Caret(base), text: "^" + to_str(base), ok: true }
  }
  let base = parse(text)
  if not base.ok {
    return bad_constraint(text)
  }
  Constraint { kind: Exact(base), text: to_str(base), ok: true }
}

fn matches(c: Constraint, v: Version) -> Bool {
  match c.kind {
    Any => true,
    Exact(base) => compare(v, base) == 0,
    Caret(base) => caret_matches(base, v),
  }
}

fn caret_matches(base: Version, v: Version) -> Bool {
  if compare(v, base) < 0 {
    return false
  }
  # Below 1.0.0 the leftmost non-zero component carries the breaking changes,
  # so ^0.2.1 admits 0.2.x but not 0.3.0, and ^0.0.3 admits only 0.0.x.
  if base.major > 0 {
    return v.major == base.major
  }
  if base.minor > 0 {
    return v.major == 0 and v.minor == base.minor
  }
  v.major == 0 and v.minor == 0
}

# highest_matching returns the index into `versions` of the greatest version
# satisfying every constraint in `cs`. None means no version satisfies them all,
# which is a resolution failure the caller has to report, and it used to be a -1
# that indexed `versions` from the end if anyone forgot to check.
#
# `best` stays a plain I64 inside the loop. It is the running position of a
# scan, not a value handed to anyone, and the check at the bottom is what turns
# it into an answer.
fn highest_matching(versions: Arr[Version], cs: Arr[Constraint]) -> Opt[I64] {
  let best = -1
  let i = 0
  while i < len(versions) {
    let v = versions[i]
    let ok = true
    let j = 0
    while j < len(cs) {
      if not matches(cs[j], v) {
        ok = false
      }
      j = j + 1
    }
    if ok {
      if best < 0 or compare(v, versions[best]) > 0 {
        best = i
      }
    }
    i = i + 1
  }
  if best < 0 {
    return None
  }
  Some(best)
}
