mode systems

# What is left of the test harness once the assertions are twill 1.11's
# `std/test`: one predicate two suites use to check that a rendering is in
# order. It records nothing. A helper here that imported `std/test` would get
# its own instance of the module and its own counter, and a failure it recorded
# would never reach the suite's `report`; that was measured, in skein, with a
# probe that came back green with a failure in it. So this file holds nothing
# that counts, and a suite passes `before` to `t.check`.
#
# Test names are written as sentences, because a failing test's name is the
# only documentation anyone reads at the moment it fails.

import "../src/strutil.tw" as s

# Whether `first` appears before `second` in `hay`. False when either is absent.
fn before(hay: Str, first: Str, second: Str) -> Bool {
  match s.index_of(hay, first) {
    Some(a) => match s.index_of(hay, second) {
      Some(b) => a < b,
      None => false,
    },
    None => false,
  }
}
