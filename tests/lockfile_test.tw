mode systems

import "harness.tw" as t
import "../src/strutil.tw" as s
import "../src/lockfile.tw" as lockfile

# `lockfile.parse` returns a `Res` now. `parsed` is for the cases that must succeed -- a
# failure there is the fixture being wrong, not the property under test -- and
# `refusal` gives the message for the cases that must be rejected, so each
# assertion keeps saying what it said before.
fn parsed(r: Res[lockfile.Lock, Str]) -> lockfile.Lock {
  match r {
    Ok(v) => v,
    Err(msg) => abort("the test expected this to parse: " + msg),
  }
}

fn refusal(r: Res[lockfile.Lock, Str]) -> Str {
  match r {
    Err(msg) => msg,
    Ok(_) => "",
  }
}


fn entry(name: Str) -> lockfile.Entry {
  lockfile.Entry {
    name: name,
    version: "1.0.0",
    git: "https://example.com/" + name,
    commit: s.repeat(name[0:1], 40),
    hash: "sha256:" + s.repeat("0", 64),
  }
}

fn render_sorts_packages_regardless_of_input_order() {
  let a = lockfile.render(lockfile.Lock { packages: [entry("zeta"), entry("alpha"), entry("mid")], err: "" })
  let b = lockfile.render(lockfile.Lock { packages: [entry("mid"), entry("zeta"), entry("alpha")], err: "" })
  t.equal_str("input order does not change the rendered lockfile", a, b)
  t.check("packages come out in name order",
    t.before(a, "alpha", "mid") and t.before(a, "mid", "zeta"))
}

fn render_is_byte_for_byte_stable_across_repeated_calls() {
  let l = lockfile.Lock { packages: [entry("a"), entry("b"), entry("c"), entry("d")], err: "" }
  let want = lockfile.render(l)
  let i = 0
  while i < 20 {
    t.equal_str("render is stable on call " + s.i64_to_str(i), lockfile.render(l), want)
    i = i + 1
  }
}

fn a_rendered_lockfile_parses_back_to_the_same_packages() {
  let l = lockfile.Lock { packages: [entry("beta"), entry("alpha")], err: "" }
  let back = parsed(lockfile.parse(lockfile.render(l)))
  t.equal_str("the round trip is exact", lockfile.render(back), lockfile.render(l))
}

fn adding_one_package_leaves_the_other_entries_untouched() {
  let before = lockfile.render(lockfile.Lock { packages: [entry("aaa"), entry("zzz")], err: "" })
  let after = lockfile.render(lockfile.Lock { packages: [entry("aaa"), entry("zzz"), entry("mmm")], err: "" })
  t.check("the earlier entry is unchanged", s.contains(after, "name = \"aaa\""))
  t.check("the later entry is unchanged", s.contains(after, "name = \"zzz\""))
  t.check("only the new entry is added", len(after) > len(before))
  # Every line of the old file must still appear in the new one, which is what
  # makes the diff of a lockfile readable in review.
  let lines = s.split_lines(before)
  let i = 0
  while i < len(lines) {
    if len(s.trim(lines[i])) > 0 {
      t.check("line survives: " + lines[i], s.contains(after, lines[i]))
    }
    i = i + 1
  }
}

fn parse_rejects_a_lockfile_from_a_newer_format_version() {
  let l_err: Str = refusal(lockfile.parse("version = 2\n"))
  t.check("a newer format version is rejected", len(l_err) > 0)
  t.check("the error says what to do", s.contains(l_err, "upgrade spool"))
}

fn parse_rejects_a_file_with_no_version_key() {
  t.check("a file with no version is not a lockfile",
    len(refusal(lockfile.parse("[[package]]\nname = \"a\"\n"))) > 0)
}

fn parse_rejects_a_package_missing_a_field() {
  let complete = "version = 1\n\n[[package]]\nname = \"a\"\nversion = \"1.0.0\"\ngit = \"g\"\n"
    + "commit = \"c\"\nhash = \"sha256:" + s.repeat("0", 64) + "\"\n"
  t.equal_str("the complete entry parses", refusal(lockfile.parse(complete)), "")
  t.check("an entry with no commit is rejected",
    len(refusal(lockfile.parse("version = 1\n\n[[package]]\nname = \"a\"\nversion = \"1.0.0\"\ngit = \"g\"\n"))) > 0)
}

fn parse_rejects_a_hash_it_cannot_verify() {
  let l_err: Str = refusal(lockfile.parse("version = 1\n\n[[package]]\nname = \"a\"\nversion = \"1.0.0\"\ngit = \"g\"\n"
    + "commit = \"c\"\nhash = \"md5:abc\"\n"))
  t.check("a digest in an unknown algorithm is rejected", len(l_err) > 0)
}

fn parse_rejects_the_same_package_locked_twice() {
  let one = "\n[[package]]\nname = \"a\"\nversion = \"1.0.0\"\ngit = \"g\"\ncommit = \"c\"\n"
    + "hash = \"sha256:" + s.repeat("0", 64) + "\"\n"
  t.check("two entries for one package are rejected", len(refusal(lockfile.parse("version = 1\n" + one + one))) > 0)
}

fn parse_rejects_unknown_keys() {
  t.check("an unknown top-level key is rejected",
    len(refusal(lockfile.parse("version = 1\nregistry = \"https://example.com\"\n"))) > 0)
  t.check("an unknown package key is rejected",
    len(refusal(lockfile.parse("version = 1\n\n[[package]]\nname = \"a\"\nsource = \"x\"\n"))) > 0)
}

fn find_looks_up_a_package_by_name() {
  let l = lockfile.Lock { packages: [entry("a"), entry("b")], err: "" }
  t.equal_opt_i64("find locates a locked package", lockfile.find(l, "b"), 1)
  t.is_none_i64("find reports a package that is not locked", lockfile.find(l, "missing"))
}

fn an_empty_lockfile_renders_and_parses() {
  let back = parsed(lockfile.parse(lockfile.render(lockfile.empty_lock())))
  # an empty lockfile parses: parsed() aborts on failure, so reaching here is the assertion
  t.equal_i64("an empty lockfile has no packages", len(back.packages), 0)
}

render_sorts_packages_regardless_of_input_order()
render_is_byte_for_byte_stable_across_repeated_calls()
a_rendered_lockfile_parses_back_to_the_same_packages()
adding_one_package_leaves_the_other_entries_untouched()
parse_rejects_a_lockfile_from_a_newer_format_version()
parse_rejects_a_file_with_no_version_key()
parse_rejects_a_package_missing_a_field()
parse_rejects_a_hash_it_cannot_verify()
parse_rejects_the_same_package_locked_twice()
parse_rejects_unknown_keys()
find_looks_up_a_package_by_name()
an_empty_lockfile_renders_and_parses()
t.report("lockfile")
